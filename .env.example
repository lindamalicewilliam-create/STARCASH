# Required by the API and Drizzle ORM. Use the DATABASE_URL supplied by Railway PostgreSQL.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required in production. Use a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Used by the Railway pre-deploy command to create/reset the Super Admin when
# all three values are provided. Leave all three unset to skip automatic seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Railway supplies PORT automatically. These are optional local defaults.
PORT=5000
BASE_PATH=/

# Optional comma-separated browser origins for cross-origin API clients.
CORS_ORIGINS=

# Optional public origin used in referral links behind a reverse proxy.
PUBLIC_APP_URL=